{
  "name": "erol-os-ipad-launcher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node tools/generate-icons.mjs",
    "test": "node --test tests/*.test.js",
    "serve": "python3 -m http.server 4173",
    "build:web": "node tools/generate-icons.mjs && node tools/build-www.mjs",
    "serve:www": "python3 -m http.server 4173 --directory www",
    "ios:add": "npm run build:web && npx cap add ios",
    "ios:sync": "npm run build:web && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "serve:hermes": "python3 tools/serve-hermes.py"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "lucide-static": "^1.47.0",
    "simple-icons": "^16.32.0"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.2",
    "@capacitor/ios": "^6.2.2"
  }
}
